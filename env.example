# Sannetic Explorer - Environment Configuration
# Copy this file to .env and configure your API keys.
# Do not commit a .env that contains real secrets.

# =============================================================================
# DOCKER ISOLATION (host ports and Compose project)
# =============================================================================
# Published on the machine so this stack can run beside other web projects.
# Container ports stay 3000 / 8000 / 5432 / 6379. Services reach each other
# by Docker DNS (db, redis, backend) on those container ports.
#
# Leave COMPOSE_PROJECT_NAME unset to keep each compose file's own name:
#   docker-compose.yml           -> sannetic-explorer
#   docker-compose.backend.yml   -> sannetic-explorer-backend
#   docker-compose.test.yml      -> sannetic-explorer-test
# Setting COMPOSE_PROJECT_NAME in this file overrides every compose file
# in the directory. Prefer `docker compose -p <name>` for a one-off override.
# COMPOSE_PROJECT_NAME=sannetic-explorer

HOST_FRONTEND_PORT=13300
HOST_BACKEND_PORT=13800
HOST_POSTGRES_PORT=15432
HOST_REDIS_PORT=16379
HOST_FLOWER_PORT=15555

# Test stack (docker-compose.test.yml), offset so it can run beside the main stack.
HOST_TEST_FRONTEND_PORT=13301
HOST_TEST_BACKEND_PORT=13801
HOST_TEST_POSTGRES_PORT=15433
HOST_TEST_REDIS_PORT=16380

# Browser-facing URLs. Must use the host ports above, not the container ports.
# If you change HOST_BACKEND_PORT, set PUBLIC_API_URL to match and rebuild the
# frontend image (the URL is passed as a build arg).
# Server-side SvelteKit loads do not use this URL. Compose sets INTERNAL_API_URL
# to http://backend:8000 (http://test-backend:8000 on the test stack).
PUBLIC_API_URL=http://localhost:13800
FRONTEND_URL=http://localhost:13300
CORS_ORIGINS=http://localhost:13300,http://localhost:3000
# Used only by the frontend container (SvelteKit load/SSR). Leave this as the
# Docker service URL. The browser keeps PUBLIC_API_URL.
# INTERNAL_API_URL=http://backend:8000
PUBLIC_TEST_API_URL=http://localhost:13801

# =============================================================================
# AI SYSTEM CONFIGURATION
# =============================================================================

# OpenAI API Configuration (for AI features)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3

# =============================================================================
# SATELLITE TRACKING APIs
# =============================================================================

# N2YO API Configuration (for real-time satellite tracking)
# Get your API key from: https://www.n2yo.com/api/
N2YO_API_KEY=your_n2yo_api_key_here
N2YO_BASE_URL=https://api.n2yo.com/rest/v1/satellite

# Space-Track.org Configuration (for TLE data)
# Register at: https://www.space-track.org/auth/createAccount
SPACE_TRACK_USERNAME=your_space_track_username
SPACE_TRACK_PASSWORD=your_space_track_password
SPACE_TRACK_BASE_URL=https://www.space-track.org

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)-20s | %(funcName)-15s | %(message)s
LOG_MAX_FILES=10

# Dashboard Configuration
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0
DASHBOARD_AUTO_REFRESH=30

# Update System Configuration
UPDATE_BATCH_SIZE=5
UPDATE_DELAY_SECONDS=2
API_RATE_LIMIT_DELAY=1

# Data Quality Thresholds
DATA_QUALITY_EXCELLENT_THRESHOLD=100
DATA_QUALITY_GOOD_THRESHOLD=50
DATA_QUALITY_FAIR_THRESHOLD=10

# =============================================================================
# AI SYSTEM SETTINGS
# =============================================================================

# AI Assistant Configuration
AI_ENABLE_ERROR_ANALYSIS=true
AI_ENABLE_ORBITAL_CALCULATIONS=true
AI_ENABLE_OPTIMIZATION=true
AI_CONFIDENCE_THRESHOLD=0.7
AI_MAX_RETRIES=3

# AI Cost Management
AI_DAILY_COST_LIMIT=5.00
AI_MONTHLY_COST_LIMIT=50.00
AI_COST_TRACKING=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# API Security
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3
API_VERIFY_SSL=true

# Dashboard Security (for future authentication)
DASHBOARD_SECRET_KEY=your_secret_key_here
DASHBOARD_SESSION_TIMEOUT=3600

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Debug Configuration
DEBUG_MODE=false
VERBOSE_LOGGING=false
DEVELOPMENT_MODE=false

# Testing Configuration
TEST_MODE=false
MOCK_API_RESPONSES=false

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1800
CACHE_MAX_SIZE=100 