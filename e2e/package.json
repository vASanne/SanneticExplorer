{
  "name": "sannetic-explorer-e2e",
  "version": "1.0.0",
  "description": "End-to-end tests for Sannetic Explorer",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:codegen": "playwright codegen http://localhost:3000",
    "test:update-screenshots": "playwright test --update-snapshots",
    "test:visual": "playwright test --grep 'Visual Regression'",
    "test:functional": "playwright test --grep-invert 'Visual Regression'"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
} 