FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    cron \
    bash \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install dumb-init as PID 1
RUN curl -Lo /usr/local/bin/dumb-init https://github.com/Yelp/dumb-init/releases/download/v1.2.5/dumb-init_1.2.5_x86_64 \
    && chmod +x /usr/local/bin/dumb-init

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy scripts directory
COPY scripts/ ./scripts/
COPY backend/scripts/ ./backend/scripts/

# Copy crontab file
COPY crontab.worker /etc/cron.d/update-cron
RUN chmod 0644 /etc/cron.d/update-cron

# Create log directory
RUN mkdir -p /var/log

# Create startup script
RUN echo '#!/bin/bash\ncron -f' > /app/start.sh && chmod +x /app/start.sh

# Use dumb-init as PID 1
ENTRYPOINT ["/usr/local/bin/dumb-init", "--"]
CMD ["/app/start.sh"] 