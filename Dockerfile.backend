# Use Python 3.12 slim image as base
FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire package
COPY sannetic_explorer/ ./sannetic_explorer/
COPY main.py .

# Copy startup script
COPY scripts/write_build_time.py ./write_build_time.py

# Create startup script that writes start time and starts the app
RUN echo '#!/bin/bash' > /app/start.sh && \
    echo 'echo "Writing backend start time to database..."' >> /app/start.sh && \
    echo 'export POSTGRES_HOST=db' >> /app/start.sh && \
    echo 'export POSTGRES_USER=postgres' >> /app/start.sh && \
    echo 'export POSTGRES_PASSWORD=postgres' >> /app/start.sh && \
    echo 'export POSTGRES_DB=sannetic_explorer' >> /app/start.sh && \
    echo 'python3 /app/write_build_time.py backend start || echo "Failed to write start time"' >> /app/start.sh && \
    echo 'echo "Starting backend application..."' >> /app/start.sh && \
    echo 'exec python main.py' >> /app/start.sh && \
    chmod +x /app/start.sh

# Create non-root user
RUN useradd --create-home --shell /bin/bash app && chown -R app:app /app
USER app

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start the application with startup script
CMD ["/app/start.sh"] 